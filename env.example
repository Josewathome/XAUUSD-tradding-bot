# ══════════════════════════════════════════════════════════════════
#  env.example — ALL CREDENTIALS
#
#  Copy to .env and fill in your real values.
#  .env is in .gitignore and must NEVER be committed to git.
#
#  NOTE: Passwords containing $, &, !, or other special characters
#  are safe here — no quoting needed.  Docker Compose may warn
#  "variable not set" when a value contains $, but the credential
#  is NOT corrupted: override_start.sh re-reads MT5_PASSWORD
#  directly from /bot/.env using grep/sed, bypassing Compose
#  interpolation entirely.
#
#  All tunable settings (risk %, session windows, SL/TP, etc.) live
#  in src/config.py — edit that file directly.
# ══════════════════════════════════════════════════════════════════


# ── MT5 Account ────────────────────────────────────────────────────
# Get these from your broker's client portal.
TRADING_ID=00000000
MT5_PASSWORD=your_mt5_password_even_with_$special&chars
MT5_SERVER=YourBroker-Demo

# Must match your actual MT5 account.
ACCOUNT_CURRENCY=USD
ACCOUNT_BALANCE=10000

# Broker/account type — controls commission table.
# Options: ZERO_SPREAD | IC_MARKETS_RAW | PREMIUM | PRO
BROKER_ACCOUNT_TYPE=ZERO_SPREAD


# ── VNC (browser remote desktop) ──────────────────────────────────
# Keep VNC_PASSWORD simple — no $ or & — it IS Compose-interpolated.
VNC_USER=admin
VNC_PASSWORD=change_me_vnc_password


# ── News API (optional) ────────────────────────────────────────────
# Leave blank to use MT5's built-in economic calendar only.
NEWS_API_KEY=
NEWS_API_URL=


# ── Dashboard (http://localhost:8001) ─────────────────────────────
DASHBOARD_PASSWORD=change_me_dashboard_password


# ── Email Alerts (optional) ────────────────────────────────────────
# Uses Gmail SMTP (smtp.gmail.com:587) by default.
# For Gmail: create an App Password at myaccount.google.com/security.
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=you@gmail.com


# ── Live Trading Switch ────────────────────────────────────────────
# false = observation mode (signals logged, no orders placed).
# Change to true only once you are confident on a demo account.
STRATEGY_GATE_ENABLED=false
