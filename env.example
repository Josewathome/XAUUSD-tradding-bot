# ── Copy this file to .env and fill in your real values ──────────────────────
# The real .env is in .gitignore and must NEVER be committed to git.

# VNC login for the MT5 browser interface (http://localhost:3001)
VNC_USER=admin
VNC_PASSWORD=change_me_secure_password

# MT5 broker credentials (use a DEMO account first)
TRADING_ID=00000000
MT5_PASSWORD=change_me
MT5_SERVER=YourBroker-Demo

# Account
ACCOUNT_CURRENCY=USD
ACCOUNT_BALANCE=10000
# Broker/account type: ZERO_SPREAD | IC_MARKETS_RAW | PREMIUM | PRO
BROKER_ACCOUNT_TYPE=ZERO_SPREAD

# Symbols (comma-separated). This bot is XAUUSD-focused.
SYMBOLS=XAUUSD

# News / external API keys (optional — leave blank to use MT5 calendar only)
NEWS_API_KEY=
NEWS_API_URL=

# Dashboard auth (optional)
DASHBOARD_PASSWORD=

# Trading is OFF by default (observation mode). The placeholder strategy emits
# no signals, so even with this enabled no trades are placed until a real
# IStrategyEngine is wired in (see src/strategy/interfaces.py).
STRATEGY_GATE_ENABLED=false

# Email alerts (optional)
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
