# ══════════════════════════════════════════════════════════════════
#  .env — VNC CREDENTIALS ONLY
#
#  Copy to .env and fill in your VNC login.
#  These two values are used directly in docker-compose.yml as
#  ${VNC_USER} and ${VNC_PASSWORD}, so Docker Compose interpolates
#  them.  Keep them simple — no $ or & characters in the values.
#
#  All other credentials (MT5, dashboard, email, etc.) go in
#  secrets.env — see secrets.example.
# ══════════════════════════════════════════════════════════════════

VNC_USER=admin
VNC_PASSWORD=change_me_vnc_password
