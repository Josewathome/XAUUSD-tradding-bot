# ══════════════════════════════════════════════════════════════════
#  env.example — SECRETS AND INFRASTRUCTURE ONLY
#
#  Copy this file to .env and fill in your real values.
#  The real .env is in .gitignore and must NEVER be committed to git.
#
#  Rule: only credentials, passwords, API keys, and account numbers
#        belong here. All tunable strategy and risk settings live in
#        src/config.py — edit that file directly, it is safe to commit.
# ══════════════════════════════════════════════════════════════════


# ── MT5 Account Credentials ────────────────────────────────────────
# Get these from your broker's client portal (demo or live account).
TRADING_ID=00000000
MT5_PASSWORD=change_me
MT5_SERVER=YourBroker-Demo

# Account currency and starting balance — used for position sizing and
# drawdown calculations. Must match your actual MT5 account.
ACCOUNT_CURRENCY=USD
ACCOUNT_BALANCE=10000

# Broker/account type. Controls which commission table is used.
# Options: ZERO_SPREAD | IC_MARKETS_RAW | PREMIUM | PRO
BROKER_ACCOUNT_TYPE=ZERO_SPREAD


# ── VNC (MT5 browser interface at http://localhost:3001) ───────────
VNC_USER=admin
VNC_PASSWORD=change_me_secure_password


# ── News API (optional) ────────────────────────────────────────────
# Leave blank to use MT5's built-in economic calendar only.
# If you run the forex-api news service, point NEWS_API_URL at it.
NEWS_API_KEY=
NEWS_API_URL=


# ── Dashboard (http://localhost:8001) ─────────────────────────────
DASHBOARD_PASSWORD=change_me_dashboard_password


# ── Email Alerts (optional) ────────────────────────────────────────
# Uses Gmail SMTP by default (smtp.gmail.com:587).
# For Gmail: create an App Password at myaccount.google.com/security.
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECIPIENT=you@gmail.com


# ── Live Trading Switch ────────────────────────────────────────────
# The bot runs in observation mode by default — signals are logged but
# NO orders are placed. Set this to true only when you are confident
# the strategy is working correctly on your demo account.
STRATEGY_GATE_ENABLED=false
